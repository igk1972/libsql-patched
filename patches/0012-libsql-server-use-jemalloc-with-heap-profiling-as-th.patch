diff --git a/libsql-server/src/heap_profile.rs b/libsql-server/src/heap_profile.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ffc3af4fb7785303596b2bcfa10b01fe9b160a2a
--- /dev/null
+++ b/libsql-server/src/heap_profile.rs
@@ -0,0 +1,143 @@
+//! jemalloc heap profiles and allocator statistics.
+//!
+//! Profiling is compiled in, but jemalloc only samples allocations when the process starts with
+//! `MALLOC_CONF=prof:true`. Profiles are read with `jeprof`.
+
+use std::ffi::{CStr, CString, OsStr};
+use std::fmt;
+use std::os::raw::c_char;
+use std::os::unix::ffi::OsStrExt;
+use std::path::PathBuf;
+use std::sync::Once;
+use std::time::Duration;
+
+use anyhow::Context as _;
+use serde::Serialize;
+use tikv_jemalloc_ctl::{epoch, raw, stats};
+
+const INTERVAL_ENV: &str = "LIBSQL_HEAP_PROFILE_INTERVAL_SECS";
+
+/// Process-wide jemalloc counters, in bytes.
+#[derive(Debug, Serialize)]
+pub struct HeapStats {
+    pub allocated: usize,
+    pub active: usize,
+    pub resident: usize,
+    pub mapped: usize,
+    pub retained: usize,
+    pub metadata: usize,
+}
+
+impl fmt::Display for HeapStats {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "allocated {}, active {}, resident {}, mapped {}, retained {}, metadata {}",
+            self.allocated, self.active, self.resident, self.mapped, self.retained, self.metadata
+        )
+    }
+}
+
+#[derive(Debug, Serialize)]
+pub struct HeapProfile {
+    pub path: PathBuf,
+    pub stats: HeapStats,
+}
+
+pub fn heap_stats() -> anyhow::Result<HeapStats> {
+    // jemalloc refreshes the stats it reports only when the epoch advances.
+    epoch::advance()?;
+    Ok(HeapStats {
+        allocated: stats::allocated::read()?,
+        active: stats::active::read()?,
+        resident: stats::resident::read()?,
+        mapped: stats::mapped::read()?,
+        retained: stats::retained::read()?,
+        metadata: stats::metadata::read()?,
+    })
+}
+
+fn profiling_enabled() -> bool {
+    unsafe { raw::read::<bool>(b"opt.prof\0") }.unwrap_or(false)
+}
+
+/// `opt.prof_prefix`, with its directory created: jemalloc does not create it and silently skips
+/// the dumps it triggers itself (`lg_prof_interval`, `prof_final`) when it is missing.
+fn prof_prefix() -> anyhow::Result<PathBuf> {
+    let prefix = unsafe { raw::read::<*const c_char>(b"opt.prof_prefix\0") }?;
+    let prefix = PathBuf::from(OsStr::from_bytes(
+        unsafe { CStr::from_ptr(prefix) }.to_bytes(),
+    ));
+    if let Some(dir) = prefix.parent().filter(|dir| !dir.as_os_str().is_empty()) {
+        std::fs::create_dir_all(dir).with_context(|| {
+            format!("failed to create heap profile directory {}", dir.display())
+        })?;
+    }
+    Ok(prefix)
+}
+
+/// Writes a heap profile to `<opt.prof_prefix>.<UTC time>.heap`.
+pub fn dump_heap_profile() -> anyhow::Result<HeapProfile> {
+    if !profiling_enabled() {
+        anyhow::bail!("heap profiling is off: start sqld with MALLOC_CONF=prof:true");
+    }
+    let mut path = prof_prefix()?.into_os_string();
+    path.push(format!(
+        ".{}.heap",
+        chrono::Utc::now().format("%Y%m%dT%H%M%S%.3fZ")
+    ));
+    let path = PathBuf::from(path);
+    let c_path = CString::new(path.as_os_str().as_bytes())?;
+    unsafe { raw::write(b"prof.dump\0", c_path.as_ptr()) }
+        .with_context(|| format!("failed to write heap profile {}", path.display()))?;
+    Ok(HeapProfile {
+        path,
+        stats: heap_stats()?,
+    })
+}
+
+/// With `LIBSQL_HEAP_PROFILE_INTERVAL_SECS` set, logs the allocator stats at that interval and,
+/// when profiling is on, writes a heap profile each time.
+pub fn start() -> anyhow::Result<()> {
+    let interval = match std::env::var(INTERVAL_ENV) {
+        Ok(value) => match value.parse::<u64>() {
+            Ok(secs) if secs > 0 => Some(Duration::from_secs(secs)),
+            _ => anyhow::bail!("{INTERVAL_ENV} must be a positive integer, got `{value}`"),
+        },
+        Err(_) => None,
+    };
+
+    static STARTED: Once = Once::new();
+    STARTED.call_once(|| {
+        if profiling_enabled() {
+            match prof_prefix() {
+                Ok(prefix) => tracing::info!(
+                    "heap profiling is on, profiles go to {}.*.heap",
+                    prefix.display()
+                ),
+                Err(e) => tracing::error!("heap profiling is on, but {e:#}"),
+            }
+        }
+        let Some(interval) = interval else { return };
+        let spawned = std::thread::Builder::new()
+            .name("heap-profile".into())
+            .spawn(move || loop {
+                std::thread::sleep(interval);
+                if profiling_enabled() {
+                    match dump_heap_profile() {
+                        Ok(p) => tracing::info!("heap profile {}: {}", p.path.display(), p.stats),
+                        Err(e) => tracing::error!("{e:#}"),
+                    }
+                } else {
+                    match heap_stats() {
+                        Ok(stats) => tracing::info!("heap: {stats}"),
+                        Err(e) => tracing::error!("failed to read jemalloc stats: {e:#}"),
+                    }
+                }
+            });
+        if let Err(e) = spawned {
+            tracing::error!("failed to start the heap profile thread: {e}");
+        }
+    });
+    Ok(())
+}
