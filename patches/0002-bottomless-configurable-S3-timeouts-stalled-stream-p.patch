diff --git a/libsql-server/src/test/bottomless.rs b/libsql-server/src/test/bottomless.rs
index f5a0aae552490c7024948ba0540cd9fa70a783cf..0cfa2c8205b456e0a5e8e52b2e596ba2892a3a82 100644
--- a/libsql-server/src/test/bottomless.rs
+++ b/libsql-server/src/test/bottomless.rs
@@ -621,6 +621,8 @@ mod snapshot_pipeline {
         fail_snapshot_puts: Arc<AtomicI64>,
         /// Delay applied to snapshot PUTs, in milliseconds.
         delay_snapshot_puts_ms: Arc<AtomicI64>,
+        /// Number of snapshot PUTs received so far.
+        snapshot_puts_seen: Arc<AtomicI64>,
     }
 
     /// An S3 implementation that delegates to the `s3s-fs` filesystem backend,
@@ -659,6 +661,9 @@ mod snapshot_pipeline {
             req: S3Request<PutObjectInput>,
         ) -> S3Result<S3Response<PutObjectOutput>> {
             if is_snapshot_key(&req.input.key) {
+                self.injector
+                    .snapshot_puts_seen
+                    .fetch_add(1, Ordering::SeqCst);
                 let delay = self.injector.delay_snapshot_puts_ms.load(Ordering::SeqCst);
                 if delay > 0 {
                     sleep(Duration::from_millis(delay as u64)).await;
@@ -768,6 +773,10 @@ mod snapshot_pipeline {
             // injected failures must surface to bottomless instead of being
             // absorbed by the SDK's internal retries
             s3_max_retries: 1,
+            s3_connect_timeout: None,
+            s3_attempt_timeout: None,
+            s3_stalled_stream_grace_period: None,
+            snapshot_upload_attempts: bottomless::replicator::SNAPSHOT_UPLOAD_ATTEMPTS,
             skip_snapshot: false,
             skip_shutdown_upload: false,
         }
@@ -1189,4 +1198,82 @@ mod snapshot_pipeline {
 
         restarted.shutdown_gracefully().await.unwrap();
     }
+
+    /// A snapshot upload whose request is accepted but never answered is cut
+    /// off by the S3 attempt timeout and retried, instead of leaving the
+    /// generation without a snapshot for as long as the connection survives.
+    #[tokio::test(flavor = "multi_thread")]
+    async fn hung_snapshot_upload_times_out_and_is_retried() {
+        let _ = tracing_subscriber::fmt::try_init();
+
+        const DB_ID: &str = "testsnapshothang";
+        const BUCKET: &str = "testsnapshothang";
+        const PATH: &str = "snapshot_hang.sqld";
+        const PORT: u16 = 9085;
+
+        let injector = S3FailureInjector::default();
+        start_flaky_s3_server(PORT, injector.clone()).await;
+        let mut options = flaky_s3_options(DB_ID, BUCKET, PORT);
+        options.s3_attempt_timeout = Some(Duration::from_secs(1));
+
+        let _cleaner = DbFileCleaner::new(PATH);
+        let replicator = init_replicator(Path::new(PATH), &options).await;
+        let replicator = Arc::new(tokio::sync::Mutex::new(Some(replicator)));
+        let conn = open_bottomless_conn(Path::new(PATH), replicator.clone()).await;
+
+        let conn = exec(
+            conn,
+            "CREATE TABLE t(id INTEGER PRIMARY KEY, v TEXT);
+             INSERT INTO t(v) VALUES ('a');",
+        )
+        .await;
+
+        // the first snapshot PUT is held far longer than the test may run;
+        // once it is in, later PUTs are answered right away
+        injector
+            .delay_snapshot_puts_ms
+            .store(600_000, Ordering::SeqCst);
+        let release = {
+            let injector = injector.clone();
+            tokio::spawn(async move {
+                while injector.snapshot_puts_seen.load(Ordering::SeqCst) == 0 {
+                    sleep(Duration::from_millis(10)).await;
+                }
+                injector.delay_snapshot_puts_ms.store(0, Ordering::SeqCst);
+            })
+        };
+
+        let (conn, checkpointed) = try_checkpoint(conn).await;
+        assert!(checkpointed, "checkpoint of a fresh database must succeed");
+
+        let generation = {
+            let mut guard = replicator.lock().await;
+            let replicator = guard.as_mut().unwrap();
+            let generation = replicator.generation().unwrap();
+            let snapshotted =
+                tokio::time::timeout(Duration::from_secs(30), replicator.wait_until_snapshotted())
+                    .await
+                    .expect("the hung snapshot upload must be cut off by the attempt timeout")
+                    .unwrap();
+            assert!(
+                snapshotted,
+                "snapshot upload must succeed after the hung attempt"
+            );
+            generation
+        };
+        release.await.unwrap();
+        assert!(
+            injector.snapshot_puts_seen.load(Ordering::SeqCst) >= 2,
+            "the hung snapshot PUT must have been retried"
+        );
+
+        let client = assertion_client(PORT).await;
+        let snapshot_key = format!("{DB_ID}-{generation}/db.gz");
+        assert!(
+            object_exists(&client, BUCKET, &snapshot_key).await,
+            "snapshot object {snapshot_key} must exist after the retried upload"
+        );
+
+        close_conn(conn).await;
+    }
 }
